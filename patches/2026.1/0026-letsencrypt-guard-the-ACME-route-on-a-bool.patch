From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roger Luethi <luethi@osism.tech>
Date: Sun, 13 Sep 2026 14:29:37 +0200
Subject: [PATCH 26/26] letsencrypt: guard the ACME route on a bool

enable_letsencrypt defaults to boolean false, and doc/source/admin/tls.rst
tells operators to set it to `true`, but five call sites still compare it
to the string 'yes'. In Jinja `true == 'yes'` is False, so under the
documented configuration the ACME http-01 challenge route is never added
to the horizon frontends and the port-80 redirect is never exempted for
the challenge path. backend acme_client_back is still created, because
its own `enabled` key has no such comparison, so it is left orphaned and
certificate acquisition fails inside the letsencrypt_lego container.

The default changed from the string "no" to false in 78f3c2b5d
("ansible-lint: Remove yaml[truthy] from excludes") without updating the
guards bbca0928b had introduced against the old string default, and
54cd57ee2 then aligned the documentation with the new type.

Use `| bool`, which is how every other consumer of enable_letsencrypt in
the loadbalancer role already coerces it.
---
 .../templates/haproxy_single_service_split.cfg.j2         | 2 +-
 ansible/roles/horizon/defaults/main.yml                   | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/ansible/roles/haproxy-config/templates/haproxy_single_service_split.cfg.j2 b/ansible/roles/haproxy-config/templates/haproxy_single_service_split.cfg.j2
index 10498e033..bae946b77 100644
--- a/ansible/roles/haproxy-config/templates/haproxy_single_service_split.cfg.j2
+++ b/ansible/roles/haproxy-config/templates/haproxy_single_service_split.cfg.j2
@@ -50,7 +50,7 @@ frontend {{ service_name }}_front
     {{ "bind %s:%s %s" | e | format(vip_address, service_port, tls_option) | trim() }}
 {#     Redirect mode sets a redirect scheme instead of a backend #}
 {%     if service_mode == 'redirect' %}
-{%         if enable_letsencrypt == 'yes' %}
+{%         if enable_letsencrypt | bool %}
     redirect scheme https code 301 if !{ ssl_fc } !{ path_reg ^/.well-known/acme-challenge/.+ }
 {%         else %}
     redirect scheme https code 301 if !{ ssl_fc }
diff --git a/ansible/roles/horizon/defaults/main.yml b/ansible/roles/horizon/defaults/main.yml
index 9250cf5b3..e87194020 100644
--- a/ansible/roles/horizon/defaults/main.yml
+++ b/ansible/roles/horizon/defaults/main.yml
@@ -34,7 +34,7 @@ horizon_services:
         port: "{% if kolla_enable_tls_internal | bool %}{{ horizon_tls_port }}{% else %}{{ horizon_port }}{% endif %}"
         listen_port: "{{ horizon_listen_port }}"
         frontend_http_extra:
-          - "{% if enable_letsencrypt == 'yes' %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
+          - "{% if enable_letsencrypt | bool %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
         backend_http_extra:
           - "balance {{ 'roundrobin' if enable_memcached | bool or horizon_backend_database | bool else 'source' }}"
           - "option httpchk"
@@ -46,7 +46,7 @@ horizon_services:
         port: "{{ horizon_port }}"
         listen_port: "{{ horizon_listen_port }}"
         frontend_redirect_extra:
-          - "{% if enable_letsencrypt == 'yes' %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
+          - "{% if enable_letsencrypt | bool %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
       horizon_external:
         enabled: "{{ haproxy_enable_horizon_external | default(enable_horizon) | bool }}"
         mode: "http"
@@ -55,7 +55,7 @@ horizon_services:
         port: "{% if kolla_enable_tls_external | bool %}{{ horizon_tls_port }}{% else %}{{ horizon_port }}{% endif %}"
         listen_port: "{{ horizon_listen_port }}"
         frontend_http_extra:
-          - "{% if enable_letsencrypt == 'yes' %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
+          - "{% if enable_letsencrypt | bool %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
         backend_http_extra:
           - "balance {{ 'roundrobin' if enable_memcached | bool or horizon_backend_database | bool else 'source' }}"
           - "option httpchk"
@@ -68,7 +68,7 @@ horizon_services:
         port: "{{ horizon_port }}"
         listen_port: "{{ horizon_listen_port }}"
         frontend_redirect_extra:
-          - "{% if enable_letsencrypt == 'yes' %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
+          - "{% if enable_letsencrypt | bool %}use_backend acme_client_back if { path_reg ^/.well-known/acme-challenge/.+ }{% endif %}"
       acme_client:
         enabled: "{{ enable_letsencrypt }}"
         with_frontend: false
