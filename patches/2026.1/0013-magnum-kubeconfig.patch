From 221c3f6113dc3e6f99e22044edbb67ad3fb65690 Mon Sep 17 00:00:00 2001
From: "Dr. Jens Harbott" <harbott@osism.tech>
Date: Sun, 23 Aug 2026 11:54:21 +0200
Subject: [PATCH 13/23] magnum-kubeconfig

Signed-off-by: Dr. Jens Harbott <harbott@osism.tech>
---
 ansible/roles/magnum/defaults/main.yml | 6 ++++++
 ansible/roles/magnum/tasks/config.yml  | 4 ++--
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/ansible/roles/magnum/defaults/main.yml b/ansible/roles/magnum/defaults/main.yml
index 0e848a729..e9951bc9b 100644
--- a/ansible/roles/magnum/defaults/main.yml
+++ b/ansible/roles/magnum/defaults/main.yml
@@ -175,6 +175,12 @@ magnum_dev_mode: "{{ kolla_dev_mode }}"
 magnum_source_version: "{{ kolla_source_version }}"
 
 
+###################
+# Kubeconfig
+###################
+magnum_kubeconfig: "{{ node_custom_config }}/magnum/kubeconfig"
+
+
 ####################
 # Notifications
 ####################
diff --git a/ansible/roles/magnum/tasks/config.yml b/ansible/roles/magnum/tasks/config.yml
index 997e5eb33..a85a50afc 100644
--- a/ansible/roles/magnum/tasks/config.yml
+++ b/ansible/roles/magnum/tasks/config.yml
@@ -30,14 +30,14 @@
 
 - name: Check if kubeconfig file is supplied
   ansible.builtin.stat:
-    path: "{{ node_custom_config }}/magnum/kubeconfig"
+    path: "{{ magnum_kubeconfig }}"
   delegate_to: localhost
   run_once: true
   register: magnum_kubeconfig_file
 
 - name: Copying over kubeconfig file
   ansible.builtin.template:
-    src: "{{ node_custom_config }}/magnum/kubeconfig"
+    src: "{{ magnum_kubeconfig }}"
     dest: "{{ node_config_directory }}/{{ item.key }}/kubeconfig"
     mode: "0660"
   become: true
-- 
2.47.3

